{
	"name": "react-gherkin-code-editor",
	"version": "1.2.6",
	"description": "React gherkin code editor is a tool designed to write and format Gherkin features and scenarios. The editor is based on Monaco editor.",
	"homepage": "https://github.com/bat3/react-gherkin-code-editor",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsup src/index.ts --format cjs,esm --dts --minify",
		"test": "jest --no-cache",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --apply .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"monaco-editor": "^0.52.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/jest": "^29.5.14",
		"@types/react": "^18.2.0 || ^19.0.0",
		"@types/react-dom": "^18.2.0 || ^19.0.0",
		"@vitejs/plugin-react": "^4.2.1",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"tsup": "^8.4.0",
		"typescript": "^5.3.0",
		"vite": "^5.0.0"
	},
	"author": "Baptiste SACCOMANDI",
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
